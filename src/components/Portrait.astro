---
// Circle portrait with aurora glow + monogram fallback.
// Drop a real photo at /public/portrait.jpg (square, ≥600px) and it will appear
// automatically. Otherwise the inline monogram is rendered.
interface Props {
  src?: string;
  alt?: string;
}
const { src = '/profile-photo.jpg', alt = 'Damian Kapłon' } = Astro.props;
---

<figure class="portrait" aria-hidden="false">
  <div class="portrait__aura" aria-hidden="true"></div>
  <div class="portrait__ring" aria-hidden="true"></div>

  <div class="portrait__frame">
    <!-- Photo (shown if it loads). The fallback monogram sits beneath. -->
    <img
      class="portrait__img"
      src={src}
      alt={alt}
      loading="eager"
      decoding="async"
      onerror="this.style.display='none'"
    />

    <!-- Fallback / placeholder monogram, visible until a real photo loads. -->
    <svg class="portrait__monogram" viewBox="0 0 200 200" aria-hidden="true">
      <defs>
        <radialGradient id="mono-bg" cx="50%" cy="35%" r="75%">
          <stop offset="0%"  stop-color="#1B3A78"/>
          <stop offset="55%" stop-color="#0E2350"/>
          <stop offset="100%" stop-color="#070F1F"/>
        </radialGradient>
      </defs>
      <circle cx="100" cy="100" r="100" fill="url(#mono-bg)"/>
      <text
        x="100" y="122"
        text-anchor="middle"
        font-family="Manrope, system-ui, sans-serif"
        font-weight="800"
        font-size="88"
        fill="#ECF2FB"
        letter-spacing="-6"
      >DK<tspan fill="#3B9AFF">.</tspan></text>
    </svg>
  </div>

  <figcaption class="portrait__caption">
    <span class="portrait__caption-line">Poland</span>
    <span class="portrait__caption-dot">·</span>
    <span class="portrait__caption-line">2026</span>
  </figcaption>
</figure>

<style>
  .portrait {
    position: relative;
    margin: 0;
    width: clamp(220px, 26vw, 340px);
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  .portrait__aura {
    position: absolute;
    inset: -22%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 30%, rgba(95, 230, 168, 0.20) 0%, transparent 45%),
      radial-gradient(circle at 70% 70%, rgba(90, 141, 214, 0.25) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(27, 58, 120, 0.35) 0%, transparent 60%);
    filter: blur(28px);
    z-index: -2;
    animation: drift 14s ease-in-out infinite alternate;
  }

  @keyframes drift {
    0%   { transform: translate3d(-2%, -1%, 0) scale(1); }
    100% { transform: translate3d(2%, 2%, 0) scale(1.06); }
  }

  .portrait__ring {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 1px solid var(--hairline-2);
    z-index: -1;
  }
  .portrait__ring::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 1px dashed rgba(95, 230, 168, 0.32);
    animation: spin 60s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .portrait__frame {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    position: relative;
    box-shadow:
      0 30px 60px -30px rgba(0, 0, 0, 0.7),
      inset 0 0 0 1px var(--hairline-2),
      inset 0 -40px 80px -40px rgba(0, 0, 0, 0.55);
  }

  .portrait__img,
  .portrait__monogram {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .portrait__monogram { z-index: 0; }
  .portrait__img     { z-index: 1; }

  .portrait__caption {
    position: absolute;
    bottom: -2rem;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .portrait__caption-dot { color: var(--amber); }
</style>
