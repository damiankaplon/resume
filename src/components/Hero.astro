---
import Portrait from './Portrait.astro';
---

<section class="hero" id="index">
  <!-- Top meta strip -->
  <div class="hero__meta">
    <span class="eyebrow"><span class="marker">00 /</span>Summary</span>
  </div>

  <hr class="hairline hero__rule" />

  <div class="hero__grid">
    <!-- Left column: typography + bio -->
    <div class="hero__type">
      <p class="hero__role reveal">Software Engineer</p>

      <h1 class="hero__name reveal">
        <span class="hero__name-line">Damian</span>
        <span class="hero__name-line hero__name-accent">Kapłon<span class="hero__name-dot">.</span></span>
      </h1>

      <p class="hero__bio reveal">
        I am a software engineer who believes the best solutions grow out of
        cooperative effort. My mission is to build systems that last without
        losing their ability to grow and adapt. By leveraging strict separation
        of concerns, I keep complexity low even as the product grows. I partner
        with teams to define problems, their spaces, and solutions —
        identifying the right challenges to tackle to ensure
        <em>high-impact</em> results.
      </p>

      <ul class="hero__socials reveal" aria-label="Social links" role="list">
        <li>
          <a href="mailto:kaplon.damian99@gmail.com" class="hero__social" aria-label="Email">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2"/>
              <path d="M3 7l9 7 9-7"/>
            </svg>
          </a>
        </li>
        <li>
          <a href="https://github.com/damiankaplon" target="_blank" rel="noreferrer" class="hero__social" aria-label="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
              <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.93.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.56 9.56 0 0 1 12 6.84c.85 0 1.71.11 2.51.33 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.95.36.31.68.92.68 1.86v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/>
            </svg>
          </a>
        </li>
        <li>
          <a href="https://www.linkedin.com/in/damian-kap%C5%82on-6b934a20b" target="_blank" rel="noreferrer" class="hero__social" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
              <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.37V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.26 2.37 4.26 5.45zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
            </svg>
          </a>
        </li>
      </ul>

      <div class="hero__cta reveal">
        <a href="#method" class="hero__btn">
          <span>Read on</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 5v14M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <span class="hero__cta-sep" aria-hidden="true"></span>
        <a href="mailto:kaplon.damian99@gmail.com" class="hero__btn hero__btn--ghost">
          <span>Get in touch</span>
        </a>
      </div>
    </div>

    <!-- Right column: portrait -->
    <div class="hero__portrait reveal">
      <Portrait />
    </div>
  </div>

  <!-- Side rail (desktop) -->
  <aside class="hero__rail" aria-hidden="true">
    <span class="hero__rail-text">building since 2016 &nbsp;—&nbsp; craft over cleverness</span>
  </aside>

  <!-- Scroll cue -->
  <div class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-label">Scroll</span>
    <span class="hero__scroll-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) var(--page-pad-x) clamp(4rem, 8vw, 7rem);
    min-height: calc(100vh - 80px);
    display: flex;
    flex-direction: column;
  }

  .hero__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
  }
  .hero__pulse {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #6ED49B;
    box-shadow: 0 0 0 0 rgba(110, 212, 155, 0.45);
    animation: pulse 2.2s ease-out infinite;
  }
  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 rgba(110, 212, 155, 0.45); }
    70%  { box-shadow: 0 0 0 9px rgba(110, 212, 155, 0); }
    100% { box-shadow: 0 0 0 0 rgba(110, 212, 155, 0); }
  }

  .hero__rule { margin: 1.25rem 0 clamp(2.5rem, 6vw, 5rem); }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    flex: 1;
  }

  .hero__type {
    max-width: 38ch;
  }

  .hero__role {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.1vw, 1.1rem);
    font-weight: 700;
    letter-spacing: -0.005em;
    color: var(--amber);
    margin-bottom: 1.2rem;
    animation-delay: 0.05s;
  }

  .hero__name {
    font-size: clamp(3.4rem, 9.5vw, 6.8rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.045em;
    color: var(--text);
    margin-bottom: 1.6rem;
    animation-delay: 0.1s;
  }
  .hero__name-line {
    display: block;
  }
  .hero__name-accent {
    color: var(--amber);
  }
  .hero__name-dot {
    color: var(--amber);
    margin-left: 0.02em;
  }

  .hero__bio {
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    line-height: 1.65;
    color: var(--text-soft);
    margin-bottom: 2.5rem;
    max-width: 42ch;
    animation-delay: 0.18s;
  }
  .hero__bio em {
    font-style: normal;
    color: var(--amber);
    font-weight: 600;
    background: linear-gradient(180deg, transparent 62%, var(--amber-glow) 62%);
    padding: 0 0.12em;
  }

  .hero__socials {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    animation-delay: 0.24s;
  }
  .hero__social {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--hairline-2);
    border-radius: 50%;
    color: var(--text-soft);
    background: rgba(232, 238, 247, 0.025);
    transition:
      color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      background 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }
  .hero__social svg { width: 16px; height: 16px; }
  .hero__social:hover {
    color: var(--amber);
    border-color: var(--amber);
    transform: translateY(-2px);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    animation-delay: 0.3s;
  }
  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text);
    padding: 0.85rem 1.4rem;
    border: 1px solid var(--hairline-3);
    border-radius: 999px;
    background: rgba(232, 238, 247, 0.02);
    transition:
      background 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out),
      color 0.35s var(--ease-out),
      transform 0.35s var(--ease-out);
  }
  .hero__btn svg {
    width: 14px;
    height: 14px;
    transition: transform 0.4s var(--ease-out);
  }
  .hero__btn:hover {
    background: var(--amber);
    color: var(--ink-deep);
    border-color: var(--amber);
  }
  .hero__btn:hover svg { transform: translateY(3px); }

  .hero__btn--ghost {
    border-color: transparent;
    color: var(--text-soft);
    padding: 0.85rem 0.4rem;
  }
  .hero__btn--ghost:hover {
    background: transparent;
    color: var(--amber);
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }

  .hero__cta-sep {
    width: 1px;
    height: 18px;
    background: var(--hairline-2);
  }

  .hero__portrait {
    display: flex;
    justify-content: center;
    animation-delay: 0.34s;
  }

  /* Vertical rail — quiet typographic detail on desktop */
  .hero__rail {
    position: absolute;
    right: -0.3rem;
    top: 50%;
    transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: lowercase;
    color: var(--text-dim);
    pointer-events: none;
  }
  .hero__rail-text { padding-block: 0.5rem; }

  /* Scroll cue */
  .hero__scroll {
    margin-top: clamp(3rem, 7vw, 5rem);
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .hero__scroll-line {
    display: inline-block;
    width: 70px;
    height: 1px;
    background: linear-gradient(to right, var(--amber), transparent);
    position: relative;
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, transparent, var(--text), transparent);
    transform: translateX(-100%);
    animation: trail 3s ease-in-out infinite;
  }
  @keyframes trail {
    0%, 30%  { transform: translateX(-100%); }
    65%      { transform: translateX(100%); }
    100%     { transform: translateX(100%); }
  }

  /* ── Tablet ──────────────────────────────── */
  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .hero__portrait {
      order: -1;
      justify-content: center;
    }
    .hero__rail { display: none; }

    /* Desktop type-column line-length caps would otherwise leave an
       empty strip on the right of narrow viewports. */
    .hero__type,
    .hero__bio { max-width: none; }

    /* Center the role label and name; bio, socials and CTAs stay left-aligned. */
    .hero__role,
    .hero__name { text-align: center; }
  }

  /* ── Mobile ──────────────────────────────── */
  @media (max-width: 560px) {
    .hero { min-height: auto; padding-bottom: 4rem; }
    .hero__meta { gap: 0.6rem; }
    .hero__meta .eyebrow { font-size: 0.66rem; }
    .hero__name { font-size: clamp(3rem, 14vw, 4.4rem); }
    .hero__cta { flex-wrap: wrap; gap: 0.8rem; }
    .hero__cta-sep { display: none; }
    .hero__bio { font-size: 1rem; }
  }
</style>
