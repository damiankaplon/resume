---
const tiles = [
  {
    num: '01',
    title: 'Collaboration Enthusiast',
    desc: 'Favours collaborative methodologies where shared understanding is the foundation of durable software.',
    icon: 'collab',
  },
  {
    num: '02',
    title: 'Performance Focused',
    desc: 'Deep dive into details to optimise and improve solution performance — planning, executing, measuring.',
    icon: 'perf',
  },
  {
    num: '03',
    title: 'Full Ownership',
    desc: 'Eager to take accountability for the complete scope of a solution — from early exploration to long-term evolution.',
    icon: 'ownership',
  },
  {
    num: '04',
    title: 'Open Minded',
    desc: 'Always exploring new ideas and architectures with curiosity — favouring pragmatic solutions, over dogmatic ones.',
    icon: 'open',
  },
];
---

<section class="about" id="method">
  <div class="about__inner">
    <div class="about__meta">
      <span class="eyebrow"><span class="marker">01 /</span>About</span>
      <span class="eyebrow about__meta-side">Four things I bring</span>
    </div>

    <hr class="hairline" />

    <header class="about__header reveal">
      <h2 class="about__title">
        How I <span class="about__title-accent">build<span class="about__title-dot">.</span></span>
      </h2>

      <p class="about__lede">
        My work is built on collaborative discovery and continuous dialogue
        with stakeholders, allowing me to translate business goals into
        well-aligned, maintainable software solutions. From early exploration
        and design to production and long-term evolution — with a strong
        focus on performance, quality, and clarity of intent. Driven by
        curiosity, I actively explore new technologies and architectural
        approaches, staying pragmatic and open-minded to deliver solutions
        that truly fit their business context.
      </p>
    </header>

    <div class="about__grid">
      {tiles.map((t, i) => (
        <article class="tile reveal" style={`transition-delay:${i * 80}ms`}>
          <div class="tile__head">
            <span class="tile__num">{t.num}</span>
            <span class="tile__rule"></span>
          </div>

          <div class="tile__icon" aria-hidden="true">
            {t.icon === 'collab' && (
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="22" cy="22" r="8"/>
                <circle cx="44" cy="28" r="6"/>
                <circle cx="30" cy="46" r="6"/>
                <path d="M22 30c-6 0-12 4-12 12h14"/>
                <path d="M44 34c-5 0-9 3-9 8"/>
                <path d="M30 52c-4 0-8 2-9 6"/>
                <path d="M28 24l14 4M40 32l-8 12M28 26l4 18"/>
              </svg>
            )}
            {t.icon === 'perf' && (
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 50h44"/>
                <path d="M14 50V36M22 50V28M30 50V18M38 50V32M46 50V24M54 50V14"/>
                <path d="M14 40l8-8 8 10 8-12 8 6 8-14" stroke-dasharray="2 3"/>
                <circle cx="54" cy="14" r="2.5" fill="currentColor"/>
              </svg>
            )}
            {t.icon === 'ownership' && (
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M32 8l22 8v14c0 14-9 22-22 26C19 52 10 44 10 30V16l22-8z"/>
                <path d="M22 32l8 8 14-16"/>
              </svg>
            )}
            {t.icon === 'open' && (
              <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="32" cy="32" r="20"/>
                <path d="M12 32h40M32 12c5 6 8 13 8 20s-3 14-8 20c-5-6-8-13-8-20s3-14 8-20z"/>
                <circle cx="48" cy="20" r="3" fill="currentColor"/>
              </svg>
            )}
          </div>

          <h3 class="tile__title">{t.title}</h3>
          <p class="tile__desc">{t.desc}</p>

          <span class="tile__corner" aria-hidden="true"></span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    border-top: 1px solid var(--hairline);
  }

  .about__inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: clamp(4rem, 8vw, 7rem) var(--page-pad-x) clamp(5rem, 10vw, 9rem);
  }

  .about__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .about__meta-side { color: var(--text-dim); }

  .about__header {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: end;
    margin: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(3.5rem, 7vw, 5.5rem);
  }

  .about__title {
    font-size: clamp(2.6rem, 6.5vw, 4.6rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--text);
  }
  .about__title-accent {
    color: var(--amber);
  }
  .about__title-dot {
    color: var(--amber);
  }

  .about__lede {
    font-size: clamp(0.98rem, 1.05vw, 1.05rem);
    line-height: 1.7;
    color: var(--text-soft);
    max-width: 52ch;
  }

  .about__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--hairline-2);
    border: 1px solid var(--hairline-2);
    border-radius: 8px;
    overflow: hidden;
  }

  .tile {
    position: relative;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background:
      linear-gradient(180deg, rgba(20, 35, 64, 0.55) 0%, rgba(10, 20, 40, 0.55) 100%);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    min-height: 280px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition:
      background 0.45s var(--ease-out),
      transform 0.45s var(--ease-out);
  }

  .tile::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      circle 140px at var(--mx, 50%) var(--my, 50%),
      rgba(95, 230, 168, 0.12) 0%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }
  .tile:hover::before { opacity: 1; }

  .tile__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(1.4rem, 3vw, 2rem);
  }
  .tile__num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    color: var(--amber);
  }
  .tile__rule {
    flex: 1;
    height: 1px;
    background: var(--hairline-2);
  }

  .tile__icon {
    width: 48px;
    height: 48px;
    color: var(--text);
    margin-bottom: 1.4rem;
    transition: color 0.4s var(--ease-out), transform 0.5s var(--ease-out);
  }
  .tile__icon svg { width: 100%; height: 100%; }
  .tile:hover .tile__icon { color: var(--amber); transform: translateY(-2px); }

  .tile__title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2vw, 1.6rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin-bottom: 0.7rem;
    color: var(--text);
  }

  .tile__desc {
    font-size: 0.96rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 38ch;
  }

  /* Decorative corner glyph */
  .tile__corner {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 14px;
    height: 14px;
    border-top: 1px solid var(--hairline-2);
    border-right: 1px solid var(--hairline-2);
    opacity: 0.6;
    transition: opacity 0.4s var(--ease-out), border-color 0.4s var(--ease-out);
  }
  .tile:hover .tile__corner {
    opacity: 1;
    border-color: var(--amber);
  }

  /* ── Tablet ─────────────────────────── */
  @media (max-width: 900px) {
    .about__header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  /* ── Mobile ─────────────────────────── */
  @media (max-width: 640px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .tile { min-height: 220px; }
  }
</style>

<script>
  // Spotlight cursor for tiles — purely decorative
  const tiles = document.querySelectorAll<HTMLElement>('.tile');
  tiles.forEach((tile) => {
    tile.addEventListener('pointermove', (e) => {
      const r = tile.getBoundingClientRect();
      tile.style.setProperty('--mx', `${e.clientX - r.left}px`);
      tile.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
